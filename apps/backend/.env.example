# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://guryeeye:guryeeye@localhost:5432/guryeeye?schema=public"

# HTTP
PORT=4000
# Comma-separated list of origins allowed to call the API (web + admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Auth — use a long random value in every non-local environment (min 32 chars)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="12h"
