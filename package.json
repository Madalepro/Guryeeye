{
  "name": "guryeeye",
  "private": true,
  "version": "0.1.0",
  "description": "Guryeeye — hotel management platform monorepo",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @guryeeye/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:shared && pnpm -r test",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:backend": "pnpm --filter @guryeeye/backend dev",
    "dev:web": "pnpm --filter @guryeeye/web dev",
    "dev:admin": "pnpm --filter @guryeeye/admin dev",
    "db:generate": "pnpm --filter @guryeeye/backend prisma:generate",
    "db:migrate": "pnpm --filter @guryeeye/backend prisma:migrate",
    "db:deploy": "pnpm --filter @guryeeye/backend prisma:deploy",
    "db:seed": "pnpm --filter @guryeeye/backend prisma:seed",
    "postinstall": "pnpm build:shared && pnpm db:generate"
  },
  "devDependencies": {
    "typescript": "~5.7.3"
  }
}
